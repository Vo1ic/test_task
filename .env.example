# This file contains the environment variables required to run the QA Auto Service Script.
# Copy this file to `.env` and fill in the actual values.

# Hugging Face token (Required for pyannote.audio speaker diarization)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN="hf_your_token_here"

# Path to the Google Cloud OAuth 2.0 Client ID (Desktop App) JSON file
# Usually downloaded as 'client_secret.json'. If placed in the project root, this variable is optional.
GOOGLE_CLIENT_SECRET="client_secret.json"
